# ScopeSentry runs every AI call against a local Ollama instance.
# Copy this file to .env.local and adjust for your machine.
# .env.local is gitignored; never commit real values.
#
# None of these values are secrets, and none are safe to prefix with NEXT_PUBLIC_:
# they are read on the server only, and the endpoint is never sent to the browser.

# Base URL of the local Ollama server. Must be a loopback address
# (localhost, 127.0.0.1, or [::1]); a non-loopback host is rejected at startup
# so pasted client text cannot leave this machine by misconfiguration.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Escape hatch for a deliberately self-hosted Ollama on your own network.
# Leave unset for normal local use. See README "Ollama client".
# OLLAMA_ALLOW_NON_LOOPBACK=1

# Instruction-tuned Gemma model, pulled separately with `ollama pull <model>`.
# Pick a size your hardware can run, for example gemma3:4b or gemma3:12b.
# The app never downloads a model: a missing tag is reported, not fetched.
OLLAMA_MODEL=gemma3:4b

# Milliseconds a single analysis request may take before it is aborted.
# Default 120000. CPU inference is slow; raise it for gemma3:12b, lower it to
# fail fast on a wedged model. Allowed range: 1000-600000.
# OLLAMA_TIMEOUT_MS=120000

# How long Ollama keeps the model loaded between requests.
# OLLAMA_KEEP_ALIVE=10m